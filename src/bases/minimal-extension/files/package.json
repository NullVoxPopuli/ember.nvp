  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch --mode development",
    "dev": "vite",
    "start": "vite"
  },
  "dependencies": {
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@glimmer/component": "^2.2.1",
