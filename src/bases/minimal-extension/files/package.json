{
  "name": "minimal-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Your Browser Extension's description here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
