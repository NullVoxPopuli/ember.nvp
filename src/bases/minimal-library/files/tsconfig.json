{
  "extends": "@ember/library-tsconfig",
  "include": ["src", "tests"],
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["ember-source/types", "@glint/ember-tsc/types"],
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  }
}
