{
  "name": "minimal-custom-element",
  "version": "0.0.0",
  "private": true,
  "description": "An Ember component, packaged as a custom element",
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "start": "tsdown --watch"
  },
  "devDependencies": {
    "@ember/library-tsconfig": "^2.0.0",
    "@glimmer/component": "^2.1.1",
    "@nullvoxpopuli/ember-rolldown": "workspace:*",
    "decorator-transforms": "^2.3.2",
    "ember-source": "~7.2.0",
    "tsdown": "^0.22.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  }
}
