{
  "name": "@nullvoxpopuli/ember-rolldown",
  "version": "2.12.0",
  "description": "Meta plugin for building ember v2 libraries/addons with rolldown & tsdown.",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./app-reexports": "./src/app-reexports.ts"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./app-reexports": {
        "types": "./dist/app-reexports.d.ts",
        "default": "./dist/app-reexports.js"
      }
    },
    "types": "dist/index.d.ts"
  },
  "keywords": [
    "rolldown",
    "tsdown",
    "ember",
    "meta plugin",
    "v2 addon",
    "library"
  ],
  "author": "NullVoxPopuli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NullVoxPopuli/ember.nvp",
    "directory": "packages/rolldown"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@babel/core": "^7.28.10 || ^8.0.0",
    "@babel/plugin-transform-typescript": "^7.28.10 || ^8.0.0",
    "@embroider/core": "^4.6.9",
    "@jridgewell/remapping": "^2.3.5",
    "@nullvoxpopuli/ember-build-tooling-utils": "workspace:*",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "content-tag": "^4.2.0",
    "decorator-transforms": "^2.4.0",
    "get-tsconfig": "^4.14.3",
    "magic-string": "^1.4.2"
  },
  "engines": {
    "node": ">= 24"
  },
  "peerDependencies": {
    "tsdown": ">= 0.22.0",
    "typescript": ">= 5.5"
  },
  "peerDependenciesMeta": {
    "tsdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@tsdown/css": "^0.22.13",
    "rolldown": "^1.2.0",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3"
  }
}
